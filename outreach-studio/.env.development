# Development environment overrides
# Dev server proxies /api requests to the API Gateway

VITE_API_URL=/api
VITE_KEYCLOAK_URL=http://localhost:8090
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=outreach-dashboard

# Set to "true" to bypass auth and use a mock admin user.
# Useful for local UI development when auth server is not running.
VITE_AUTH_BYPASS=false
