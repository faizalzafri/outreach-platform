# Development environment overrides
# Dev server proxies /api requests to the API Gateway

VITE_API_URL=/api
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=outreach
VITE_KEYCLOAK_CLIENT_ID=outreach-studio

# Set to "true" to bypass Keycloak auth and use a mock admin user.
# Useful for local UI development when Keycloak is not running.
VITE_AUTH_BYPASS=true
