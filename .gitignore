# Kito / Kiro (Generic editor swap and backup patterns)
*.swp
*.swo
*~
.kiro/

# Generic OS files
.DS_Store
Thumbs.db
desktop.ini


# ==============================================================================
# Java Build Tools (Maven & Gradle)
# ==============================================================================

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.next
pom.xml.versionsBackup
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/.maven-wrapper.properties

# Gradle
.gradle/
build/
!src/**/build/
.cache/

# Gradle Wrapper elements to ignore if you want to force local installation
# (Remove the '!' lines if you do not want to commit the gradle wrapper)
!gradle-wrapper.jar
!gradlew
!gradlew.bat


