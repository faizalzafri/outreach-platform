  "cards": [
    {
      "dot": "emerald",
      "title": "Invite and activate",
      "items": [
        "No password is ever set or shared by an admin",
        "The emailed link carries a random token; only its SHA-256 is stored",
        "Activation enforces the password policy (length, classes, common words, name/email, history)"
      ]
    },
    {
      "dot": "violet",
      "title": "Delivery",
      "items": [
        "auth-service writes events to its outbox with the change; a poller publishes them",
        "notification-service sends identity emails at once and stores them redacted",
        "Channels are pluggable: email today (OtpSender / MessageChannelSender)"
      ]
    },
    {
      "dot": "rose",
      "title": "One-time code",
      "items": [
        "Required per organization policy for sign-in, reset or password change",
        "Limited attempts and expiry; resend has a cooldown",
        "No email on the account and a code required: sign-in fails closed"
      ]
    }
  ]
