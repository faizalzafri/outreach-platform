  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Studio calls /api via the gateway with a JWT from auth-service",
        "Gateway strips client X-Tenant-ID, sets it from the token, blocks deactivated tenants, makes suspended ones read-only",
        "Services resolve each other through Eureka (lb://)"
      ]
    },
    {
      "dot": "violet",
      "title": "Events",
      "items": [
        "Services write an outbox; a poller publishes to the outreach.events exchange",
        "auth-service publishes identity.* (invites, resets, codes, user changes); event-service syncs its user directory from them",
        "report-service publishes report.scheduled for emailed reports"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data",
      "items": [
        "Shared Postgres schema, tenant_id on every table",
        "Mongo holds outboxes, audit log, import jobs and email deliveries",
        "Redis keys are prefixed by tenant"
      ]
    }
  ]
