  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9005",
      "description": "Base URL for the Report Service"
    },
    {
      "key": "accessToken",
      "value": "",
      "description": "OAuth2 Bearer token"
    },
    {
      "key": "exportJobId",
      "value": "d4e5f6a7-b8c9-0123-abcd-ef4567890123",
      "description": "Sample export job UUID"
    },
    {
      "key": "scheduleId",
      "value": "e5f6a7b8-c9d0-1234-abcd-ef5678901234",
      "description": "Sample scheduled report UUID"
    }
  ],
