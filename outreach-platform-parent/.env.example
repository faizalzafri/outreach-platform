# PostgreSQL
POSTGRES_DB=outreachfeedbackdb
POSTGRES_USER=outreach
POSTGRES_PASSWORD=outreach_secret

# MongoDB
MONGO_DB=outreach_nosql

# Redis
REDIS_PASSWORD=redis_secret

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Config Server
CONFIG_SERVER_USER=configadmin
CONFIG_SERVER_PASSWORD=configsecret
ENCRYPT_KEY=dev-encrypt-key-change-in-production

# SMTP (defaults to MailHog for local development)
SMTP_HOST=mailhog
SMTP_PORT=1025
