# PostgreSQL
POSTGRES_DB=outreachfeedbackdb
POSTGRES_USER=outreach
POSTGRES_PASSWORD=outreach_secret

# MongoDB
MONGO_DB=outreach_nosql

# Redis
REDIS_PASSWORD=redis_secret

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# SMTP (defaults to MailHog for local development)
SMTP_HOST=mailhog
SMTP_PORT=1025
