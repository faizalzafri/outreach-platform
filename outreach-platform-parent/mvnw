# Maven Wrapper script - delegates to system Maven
# Full wrapper JAR can be generated with: mvn wrapper:wrapper

set -e

WRAPPER_DIR="$(cd "$(dirname "$0")" && pwd)"

if [ ! -f "$WRAPPER_DIR/.mvn/wrapper/maven-wrapper.properties" ]; then
    echo "Cannot find .mvn/wrapper/maven-wrapper.properties"
    exit 1
fi

# Fallback: use system Maven
if command -v mvn >/dev/null 2>&1; then
    exec mvn "$@"
else
    echo "Maven not found. Please install Maven or run: mvn wrapper:wrapper"
    exit 1
fi
